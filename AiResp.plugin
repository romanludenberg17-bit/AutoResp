from __future__ import annotations

import datetime as dt
import random
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from typing import Any, Dict, List, Optional, Tuple

import requests
from android_utils import run_on_ui_thread
from base_plugin import BasePlugin, HookResult
from client_utils import EXTERNAL_NETWORK_QUEUE, get_last_fragment, run_on_queue, send_text
from ui.alert import AlertDialogBuilder
from ui.settings import Divider, EditText, Header, Input, Selector, Switch, Text
from android.content import Intent
from android.net import Uri

__id__ = "autoresp"
__name__ = "AutoResp — AI"
__description__ = "AI-автоответчик exteraGram с поддержкой Gemini, Groq и OpenRouter, автоматическим fallback, проверкой API и понятной диагностикой."
__author__ = "@h0nkey"
__version__ = "1.4.1"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.5.0"

GEMINI_BASES = ("https://generativelanguage.googleapis.com/v1beta", "https://generativelanguage.googleapis.com/v1")
OPENAI_BASES = {"groq": "https://api.groq.com/openai/v1", "openrouter": "https://openrouter.ai/api/v1"}
PROVIDERS = ("gemini", "groq", "openrouter")
PROVIDER_NAMES = {"gemini": "Gemini", "groq": "Groq", "openrouter": "OpenRouter"}
AUTHOR_CHANNEL = "https://t.me/rommy_apps"
DEFAULT_PROMPT = ("ты — мой личный автоответчик в Telegram. отвечай естественно, коротко и по-человечески. "
                  "не говори, что ты бот или ИИ, если тебя прямо об этом не спрашивают. "
                  "не выдумывай факты обо мне. учитывай контекст предыдущих сообщений. "
                  "не отправляй рекламу, ссылки или массовые сообщения без явной причины.")
QUALITY = {0: {"tokens": 384, "temperature": 0.55}, 1: {"tokens": 768, "temperature": 0.70}, 2: {"tokens": 1536, "temperature": 0.80}}


class AutoRespPlugin(BasePlugin):
    WATCHED = {"TL_updateNewMessage", "TL_updateNewChannelMessage", "TL_updateShortMessage", "TL_updateShortChatMessage"}

    def __init__(self):
        super().__init__()
        self._seen: set[Tuple[int, int, int]] = set()
        self._pending: set[Tuple[int, int, int]] = set()
        self._context: Dict[Tuple[int, int], List[Tuple[str, str]]] = {}
        self._last_reply: Dict[Tuple[int, int], float] = {}
        self._model_cache: Dict[Tuple[str, str], Tuple[str, float]] = {}
        self._quota_block: Dict[str, float] = {}
        self._lock = threading.RLock()
        self._executor: Optional[ThreadPoolExecutor] = None
        self._loaded = False
        self._stats = {"updates": 0, "containers": 0, "messages": 0, "queued": 0, "sent": 0, "errors": 0,
                       "last_dialog": "", "last_current_dialog": "", "last_skip": "", "last_error": "", "last_provider": ""}

    def create_settings(self) -> List[Any]:
        return [
            Header(text="AutoResp — AI"),
            Switch(key="enabled", text="Включить автоответчик", subtext="Не отвечает, если ты уже находишься в этом чате", default=False),
            Switch(key="fallback_enabled", text="Автопереключение AI", subtext="Если один API не отвечает — автоматически пробовать следующий", default=True),
            Switch(key="fast_mode", text="Максимальная скорость", subtext="Без искусственной задержки", default=True),
            Text(text="Проверить работу плагина", icon="msg_check", on_click=lambda _v: self._test_plugin()),
            Text(text="Проверить все API", icon="msg_check", on_click=lambda _v: self._test_api()),
            Text(text="Диагностика", icon="msg_info", on_click=lambda _v: self._show_diagnostics()),
            Text(text="Канал автора", icon="msg_channel", on_click=lambda _v: self._open_author_channel()),
            Text(text="? Как пользоваться", icon="msg_help", on_click=lambda _v: self._show_help()),
            Divider(text="Провайдеры AI"),
            Selector(key="provider", text="Основной AI-провайдер", items=["Gemini", "Groq", "OpenRouter"], default=0),
            Input(key="api_key", text="Gemini API key", default="", subtext="Ключ для Gemini"),
            Input(key="groq_api_key", text="Groq API key", default="", subtext="Ключ для Groq"),
            Input(key="openrouter_api_key", text="OpenRouter API key", default="", subtext="Ключ для OpenRouter"),
            Input(key="model", text="Модель", default="auto", subtext="auto — подобрать доступную модель автоматически"),
            Selector(key="quality", text="Режим качества", items=["Экономный", "Рекомендуемый", "Усиленный"], default=1),
            EditText(key="prompt", hint="Системный промпт", default=DEFAULT_PROMPT, multiline=True, max_length=6000),
            Divider(text="Автоответчик"),
            Switch(key="private_only", text="Только личные сообщения", subtext="Без групп и каналов", default=True),
            Switch(key="reply_to_groups", text="Отвечать в группах", subtext="Работает, если режим выше выключен", default=False),
            Input(key="delay_min", text="Минимальная задержка, сек", default="0"),
            Input(key="delay_max", text="Максимальная задержка, сек", default="0"),
            Input(key="cooldown", text="Пауза между автоответами, сек", default="0"),
            Input(key="context_count", text="Сообщений контекста", default="8"),
            Divider(text="Расписание"),
            Selector(key="schedule_mode", text="Когда отвечать", items=["Всегда", "По расписанию"], default=0),
            Input(key="start_date", text="Дата начала", default="", subtext="YYYY-MM-DD"),
            Input(key="end_date", text="Дата окончания", default="", subtext="YYYY-MM-DD"),
            Input(key="start_time", text="Время начала", default="00:00", subtext="HH:MM"),
            Input(key="end_time", text="Время окончания", default="23:59", subtext="HH:MM"),
            Divider(), Text(text="AutoResp 1.4.1 • Gemini + Groq + OpenRouter", subtext="Fallback, проверка всех API и понятные отчёты")
        ]

    def on_plugin_load(self):
        if self._loaded: return
        self._loaded = True
        with self._lock:
            if self._executor is None: self._executor = ThreadPoolExecutor(max_workers=4, thread_name_prefix="AutoResp")
        for name in sorted(self.WATCHED):
            try: self.add_hook(name)
            except Exception as exc: self._record_error("hook %s: %s" % (name, exc))
        for name in ("TL_updates", "TL_updatesCombined"):
            try: self.add_hook(name)
            except Exception: pass
        self.logger.info("AutoResp 1.4.1 loaded")

    def on_plugin_unload(self):
        self._loaded = False
        with self._lock:
            executor = self._executor; self._executor = None
            self._seen.clear(); self._pending.clear(); self._context.clear(); self._last_reply.clear(); self._model_cache.clear()
        if executor:
            try: executor.shutdown(wait=False, cancel_futures=True)
            except Exception: pass

    def on_update_hook(self, update_name: str, account: int, update: Any) -> HookResult:
        with self._lock: self._stats["updates"] += 1
        if not self._loaded or not bool(self.get_setting("enabled", False)) or update_name not in self.WATCHED: return HookResult()
        try: self._process_single_update(update_name, account, update)
        except Exception as exc: self._record_error(str(exc))
        return HookResult()

    def on_updates_hook(self, container_name: str, account: int, updates: Any) -> HookResult:
        with self._lock: self._stats["containers"] += 1
        if not self._loaded or not bool(self.get_setting("enabled", False)): return HookResult()
        try:
            if container_name in self.WATCHED: self._process_single_update(container_name, account, updates)
            else:
                for item in self._container_items(updates):
                    name = self._name(item)
                    if name in self.WATCHED: self._process_single_update(name, account, item)
        except Exception as exc: self._record_error(str(exc))
        return HookResult()

    def _name(self, obj: Any) -> str:
        try: return str(obj.getClass().getSimpleName())
        except Exception: return type(obj).__name__.split("$")[-1]

    def _container_items(self, container: Any) -> List[Any]:
        for attr in ("updates", "updates_list"):
            value = getattr(container, attr, None)
            if value is not None:
                try: return list(value)
                except Exception: pass
        try: return list(container)
        except Exception: return []

    def _process_single_update(self, update_name: str, account: int, update: Any):
        _, dialog_id, message_id, text, outgoing, is_group = self._extract_update(update_name, update)
        if not text: return self._skip("empty_text")
        if not dialog_id: return self._skip("dialog=0")
        if not message_id or outgoing: return self._skip("outgoing_or_no_id")
        if update_name == "TL_updateNewChannelMessage": is_group = True
        if is_group:
            if bool(self.get_setting("private_only", True)): return self._skip("private_only")
            if not bool(self.get_setting("reply_to_groups", False)): return self._skip("groups_disabled")
        self._accept_message(account, int(dialog_id), int(message_id), text, is_group)

    def _extract_update(self, name: str, update: Any):
        message = getattr(update, "message", None) or getattr(update, "messageOwner", None) or update
        message_id = self._int_attr(message, "id", self._int_attr(update, "id", 0))
        text = self._text_from(message) or (self._text_from(update) if message is not update else "")
        outgoing = bool(getattr(message, "out", getattr(update, "out", False)))
        if name == "TL_updateShortMessage": return message, self._int_attr(update, "user_id", 0) or None, message_id, self._text_from(update), bool(getattr(update, "out", False)), False
        if name == "TL_updateShortChatMessage":
            cid = self._int_attr(update, "chat_id", 0); return message, -cid if cid else None, message_id, self._text_from(update), bool(getattr(update, "out", False)), True
        dialog = self._dialog_of(message); return message, dialog, message_id, text, outgoing, bool(dialog and dialog < 0)

    def _dialog_of(self, message: Any) -> Optional[int]:
        try:
            from org.telegram.messenger import MessageObject
            value = int(MessageObject.getDialogId(message))
            if value: return value
        except Exception: pass
        getter = getattr(message, "getDialogId", None)
        if callable(getter):
            try:
                value = int(getter())
                if value: return value
            except Exception: pass
        peer = getattr(message, "peer_id", None) or getattr(message, "peerId", None)
        value = self._peer_id(peer)
        if value: return value
        source = getattr(message, "from_id", None) or getattr(message, "fromId", None)
        return self._peer_id(source)

    def _peer_id(self, obj: Any) -> Optional[int]:
        if obj is None: return None
        try:
            for a in ("user_id", "userId"):
                value = int(getattr(obj, a, 0) or 0)
                if value: return value
            for a in ("chat_id", "chatId", "channel_id", "channelId"):
                value = int(getattr(obj, a, 0) or 0)
                if value: return -value
        except Exception: pass
        return None

    def _text_from(self, obj: Any) -> str:
        for attr in ("message", "text"):
            value = getattr(obj, attr, None)
            if isinstance(value, str): return value.strip()
        return ""

    def _int_attr(self, obj: Any, name: str, default: int = 0) -> int:
        try: return int(getattr(obj, name, default) or default)
        except Exception: return default

    def _current_open_dialog(self, account: Optional[int] = None) -> int:
        try:
            fragment = get_last_fragment()
            if fragment is None: return 0
            try: class_name = str(fragment.getClass().getSimpleName())
            except Exception: class_name = type(fragment).__name__.split("$")[-1]
            if "ChatActivity" not in class_name: return 0
            getter = getattr(fragment, "getDialogId", None)
            if not callable(getter): return 0
            dialog = int(getter() or 0)
            if not dialog: return 0
            return dialog
        except Exception: return 0

    def _accept_message(self, account: int, dialog_id: int, message_id: int, text: str, is_group: bool):
        current = self._current_open_dialog(account)
        with self._lock: self._stats["last_current_dialog"] = str(current or 0)
        if current == int(dialog_id): return self._skip("chat_open_user_present")
        key = (int(account), int(dialog_id), int(message_id)); now = time.time()
        with self._lock:
            if key in self._seen or key in self._pending: return self._skip("duplicate")
            self._seen.add(key); self._stats["messages"] += 1
            if len(self._seen) > 10000: self._seen = set(list(self._seen)[-5000:])
        if not self._schedule_allows(now): return self._skip("schedule")
        cooldown = self._number_setting("cooldown", 0.0, 0.0, 86400.0); last_key = (int(account), int(dialog_id))
        with self._lock:
            if cooldown and now - self._last_reply.get(last_key, 0.0) < cooldown: return self._skip("cooldown")
            self._pending.add(key); self._stats["queued"] += 1
        delay = 0 if bool(self.get_setting("fast_mode", True)) else self._delay_seconds()
        task = lambda: self._worker(account, dialog_id, text, key, is_group)
        if delay > 0:
            try: run_on_queue(task, EXTERNAL_NETWORK_QUEUE, int(delay * 1000))
            except Exception as exc: self._pending.discard(key); self._record_error(str(exc))
        else: self._submit(task, key)

    def _submit(self, task, key):
        with self._lock: executor = self._executor
        if executor is None: self._pending.discard(key); return self._record_error("executor unavailable")
        try: executor.submit(task)
        except Exception as exc: self._pending.discard(key); self._record_error(str(exc))

    def _worker(self, account: int, dialog_id: int, text: str, key, is_group: bool):
        try:
            if self._current_open_dialog(account) == int(dialog_id): return self._skip("chat_open_before_ai")
            answer, provider = self._generate_with_fallback(text, self._get_context(account, dialog_id), is_group)
            if not answer: return self._record_error("all AI providers failed")
            if self._current_open_dialog(account) == int(dialog_id): return self._skip("chat_open_before_send")
            send_text(dialog_id, answer[:4096], account=account)
            with self._lock:
                self._last_reply[(account, dialog_id)] = time.time(); self._stats["sent"] += 1; self._stats["last_provider"] = provider
                ctx = self._context.setdefault((account, dialog_id), []); ctx.extend((("user", text), ("assistant", answer)))
                limit = max(2, int(self._number_setting("context_count", 8, 2, 30))); self._context[(account, dialog_id)] = ctx[-limit:]
        except Exception as exc:
            with self._lock: self._stats["errors"] += 1
            self._record_error(str(exc))
        finally:
            with self._lock: self._pending.discard(key)

    def _provider(self) -> str:
        value = self.get_setting("provider", 0)
        if isinstance(value, str):
            low = value.lower()
            if "groq" in low: return "groq"
            if "openrouter" in low: return "openrouter"
        try: value = int(value)
        except Exception: value = 0
        return PROVIDERS[value] if value in range(3) else "gemini"

    def _provider_chain(self) -> List[str]:
        primary = self._provider()
        if not bool(self.get_setting("fallback_enabled", True)): return [primary]
        return [primary] + [p for p in PROVIDERS if p != primary]

    def _api_key(self, provider: str) -> str:
        key_name = {"gemini": "api_key", "groq": "groq_api_key", "openrouter": "openrouter_api_key"}[provider]
        return str(self.get_setting(key_name, "") or "").strip()

    def _generate_with_fallback(self, text: str, context, is_group: bool):
        errors = []
        for provider in self._provider_chain():
            key = self._api_key(provider)
            if not key:
                errors.append(provider + ": key не задан"); continue
            if self._quota_block.get(provider, 0) > time.time():
                errors.append(provider + ": временно заблокирован после 429"); continue
            try:
                answer = self._generate(provider, key, text, context, is_group)
                if answer.strip(): return answer.strip(), provider
                errors.append(provider + ": пустой ответ")
            except Exception as exc:
                errors.append(provider + ": " + str(exc)[:180])
                self.logger.warning("AutoResp provider %s failed; trying next", provider)
        raise RuntimeError("; ".join(errors))

    def _get_context(self, account, dialog_id):
        with self._lock: return list(self._context.get((account, dialog_id), []))

    def _quality(self):
        try: value = int(self.get_setting("quality", 1) or 1)
        except Exception: value = 1
        return QUALITY.get(value, QUALITY[1])

    def _generate(self, provider, api_key, text, context, is_group):
        q = self._quality(); prompt = str(self.get_setting("prompt", DEFAULT_PROMPT) or DEFAULT_PROMPT).strip()
        history = "\n".join(f"{role}: {item}" for role, item in context[-20:])
        user_text = (f"контекст:\n{history}\n\n" if history else "") + f"новое сообщение: {text}"
        if is_group: user_text += "\nэто групповая переписка; отвечай только на само сообщение."
        model = self._resolve_model(provider, api_key)
        if provider == "gemini":
            payload = {"systemInstruction": {"parts": [{"text": prompt}]}, "contents": [{"role": "user", "parts": [{"text": user_text}]}], "generationConfig": {"temperature": q["temperature"], "maxOutputTokens": q["tokens"]}}
            response = None; last = ""
            for base in GEMINI_BASES:
                try:
                    response = requests.post(f"{base}/models/{model}:generateContent", params={"key": api_key}, json=payload, timeout=35)
                    if response.status_code != 404 or base == GEMINI_BASES[-1]: break
                except Exception as exc: last = str(exc)
            if response is None: raise RuntimeError(last or "Gemini network error")
            if response.status_code != 200: self._handle_http_error(provider, response)
            return self._extract_text(response.json())
        payload = {"model": model, "messages": [{"role": "system", "content": prompt}, {"role": "user", "content": user_text}], "temperature": q["temperature"], "max_tokens": q["tokens"]}
        headers = {"Authorization": "Bearer " + api_key, "Content-Type": "application/json"}
        if provider == "openrouter": headers.update({"HTTP-Referer": "https://t.me/rommy_apps", "X-Title": "AutoResp"})
        try: response = requests.post(OPENAI_BASES[provider] + "/chat/completions", headers=headers, json=payload, timeout=35)
        except Exception as exc: raise RuntimeError("network: " + str(exc))
        if response.status_code != 200: self._handle_http_error(provider, response)
        try: return str(response.json()["choices"][0]["message"]["content"] or "").strip()
        except Exception as exc: raise RuntimeError("invalid AI response: " + str(exc))

    def _resolve_model(self, provider, api_key):
        manual = str(self.get_setting("model", "auto") or "auto").strip()
        if manual.lower() != "auto": return manual.replace("models/", "")
        cache_key = (provider, api_key); cached = self._model_cache.get(cache_key)
        if cached and time.time() - cached[1] < 1800: return cached[0]
        if provider == "gemini":
            candidates = []
            for base in GEMINI_BASES:
                try:
                    r = requests.get(base + "/models", params={"key": api_key}, timeout=12)
                    if r.status_code != 200: continue
                    for item in r.json().get("models", []) or []:
                        name = str(item.get("name", "")).replace("models/", ""); methods = item.get("supportedGenerationMethods", []) or []
                        if name and "generateContent" in methods and not any(x in name.lower() for x in ("embedding", "image", "tts", "live", "audio", "robotics")):
                            low = name.lower(); score = 0 if "flash-lite" in low else 1 if "flash" in low else 2 if "pro" in low else 3; candidates.append((score, name))
                    if candidates: break
                except Exception: pass
            if not candidates: raise RuntimeError("не удалось определить Gemini-модель")
            model = sorted(candidates)[0][1]
        else:
            try: r = requests.get(OPENAI_BASES[provider] + "/models", headers={"Authorization": "Bearer " + api_key}, timeout=15)
            except Exception as exc: raise RuntimeError("models network: " + str(exc))
            if r.status_code != 200: self._handle_http_error(provider, r)
            candidates = []
            for item in r.json().get("data", []) or []:
                name = str(item.get("id", "")); low = name.lower()
                if not name or any(x in low for x in ("embedding", "whisper", "moderation", "guard")): continue
                free = provider == "openrouter" and self._is_free_openrouter(item)
                score = (0 if free else 1, 0 if any(x in low for x in ("llama", "qwen", "gpt-oss", "mistral")) else 1, name)
                candidates.append((score, name))
            if not candidates: raise RuntimeError("нет доступных chat-моделей")
            model = sorted(candidates)[0][1]
        self._model_cache[cache_key] = (model, time.time()); return model

    def _is_free_openrouter(self, item):
        pricing = item.get("pricing", {}) or {}
        try: return float(pricing.get("prompt", 1)) == 0 and float(pricing.get("completion", 1)) == 0
        except Exception: return ":free" in str(item.get("id", ""))

    def _handle_http_error(self, provider, response):
        status = int(getattr(response, "status_code", 0)); detail = self._short_error(getattr(response, "text", ""))
        if status == 429: self._quota_block[provider] = time.time() + 600
        raise RuntimeError(f"HTTP {status}: {detail or 'API error'}")

    def _extract_text(self, data):
        parts = []
        for candidate in data.get("candidates", []) or []:
            for part in (candidate.get("content", {}) or {}).get("parts", []) or []:
                if part.get("text"): parts.append(str(part["text"]))
        return "\n".join(parts).strip()

    def _schedule_allows(self, timestamp):
        try: mode = int(self.get_setting("schedule_mode", 0) or 0)
        except Exception: mode = 0
        if mode == 0: return True
        now = dt.datetime.fromtimestamp(timestamp); start_date = str(self.get_setting("start_date", "") or "").strip(); end_date = str(self.get_setting("end_date", "") or "").strip()
        try:
            if start_date and now.date() < dt.date.fromisoformat(start_date): return False
            if end_date and now.date() > dt.date.fromisoformat(end_date): return False
        except ValueError: return False
        def hm(v, d):
            try: return dt.time.fromisoformat(str(v or d).strip())
            except ValueError: return dt.time.fromisoformat(d)
        start = hm(self.get_setting("start_time", "00:00"), "00:00"); end = hm(self.get_setting("end_time", "23:59"), "23:59")
        return start <= now.time() <= end if start <= end else now.time() >= start or now.time() <= end

    def _delay_seconds(self):
        low = self._number_setting("delay_min", 0, 0, 3600); high = self._number_setting("delay_max", low, low, 3600); return random.uniform(low, high)

    def _number_setting(self, key, default, minimum=0, maximum=3600):
        try: return max(minimum, min(maximum, float(str(self.get_setting(key, default)).replace(",", "."))))
        except Exception: return default

    def _short_error(self, text): return " ".join(str(text or "").split())[:500]
    def _record_error(self, message):
        with self._lock: self._stats["last_error"] = str(message)[:500]
    def _skip(self, reason):
        with self._lock: self._stats["last_skip"] = str(reason)[:200]

    def _friendly_error(self, provider, exc):
        text = self._short_error(exc).lower()
        name = PROVIDER_NAMES.get(provider, provider)
        if "429" in text or "quota" in text or "rate limit" in text:
            return f"{name}: лимит запросов или временное ограничение."
        if "401" in text or "403" in text or "unauthorized" in text or "forbidden" in text or "invalid api" in text:
            return f"{name}: API key не принят. Проверь ключ."
        if "timeout" in text or "timed out" in text:
            return f"{name}: сервер не ответил вовремя."
        if "network" in text or "connection" in text or "dns" in text:
            return f"{name}: нет соединения с сервером."
        if "model" in text:
            return f"{name}: не удалось найти доступную модель."
        return f"{name}: API не прошёл проверку."

    def _test_plugin(self):
        chain = list(PROVIDERS)
        self._submit(lambda: self._test_plugin_worker(chain), (0, 1, int(time.time() * 1000)))

    def _test_api(self):
        chain = list(PROVIDERS)
        self._submit(lambda: self._test_api_worker(chain), (0, 2, int(time.time() * 1000)))

    def _test_api_worker(self, providers):
        lines = ["Проверка всех AI API", ""]
        any_configured = False
        for provider in providers:
            name = PROVIDER_NAMES[provider]; key = self._api_key(provider)
            if not key:
                lines.append(f"⚪ {name}: не настроен — API key не указан")
                continue
            any_configured = True
            try:
                model = self._resolve_model(provider, key)
                lines.append(f"🟢 {name}: работает\n   Модель: {model}")
            except Exception as exc:
                lines.append(f"🔴 {name}: {self._friendly_error(provider, exc)}")
        if not any_configured: lines.append("\nДобавь хотя бы один API key в настройках AutoResp.")
        else: lines.append("\nПроверка завершена. Ключи и технические ошибки не показываются в этом отчёте.")
        self._dialog("Статус AI API", "\n".join(lines))

    def _test_plugin_worker(self, providers):
        lines = ["Проверка AutoResp", ""]
        lines.append("🟢 Плагин загружен" if self._loaded else "🔴 Плагин не загружен")
        lines.append("🟢 Фоновый обработчик готов" if self._executor is not None else "🔴 Фоновый обработчик недоступен")
        configured = [p for p in providers if self._api_key(p)]
        if not configured:
            lines.append("🔴 AI не настроен: нет ни одного API key")
            return self._dialog("Проверка AutoResp", "\n".join(lines) + "\n\nОткрой настройки и добавь ключ Gemini, Groq или OpenRouter.")
        lines.append("")
        lines.append("Проверка API:")
        working = []
        for provider in providers:
            key = self._api_key(provider)
            name = PROVIDER_NAMES[provider]
            if not key:
                lines.append(f"⚪ {name}: не настроен")
                continue
            try:
                model = self._resolve_model(provider, key)
                lines.append(f"🟢 {name}: доступен ({model})")
                working.append((provider, key, model))
            except Exception as exc:
                lines.append(f"🔴 {name}: {self._friendly_error(provider, exc)}")
        if not working:
            lines.append("\n🔴 Проверка AI не пройдена. Добавь рабочий API key или проверь интернет.")
            return self._dialog("Проверка AutoResp", "\n".join(lines))
        provider, key, model = working[0]
        try:
            answer = self._generate(provider, key, "Проверка AutoResp. Ответь одним коротким словом: ОК", [], False)
            if answer.strip():
                lines.append(f"\n🟢 Тестовый запрос: успешно ({PROVIDER_NAMES[provider]})")
                lines.append("\nПлагин готов к работе.")
            else:
                lines.append("\n🟡 API доступен, но не вернул ответ.")
        except Exception as exc:
            lines.append(f"\n🔴 Тестовый запрос не выполнен: {self._friendly_error(provider, exc)}")
        self._dialog("Проверка AutoResp", "\n".join(lines))

    def _show_diagnostics(self):
        with self._lock: s = dict(self._stats); pending = len(self._pending)
        blocked = ", ".join(PROVIDER_NAMES.get(p, p) for p, until in self._quota_block.items() if until > time.time()) or "нет"
        self._dialog("Диагностика AutoResp", f"основной: {PROVIDER_NAMES.get(self._provider(), self._provider())}\nцепочка: {' → '.join(PROVIDER_NAMES.get(p, p) for p in self._provider_chain())}\nпоследний AI: {PROVIDER_NAMES.get(s['last_provider'], s['last_provider']) or 'нет'}\n429-блокировки: {blocked}\nвходящих: {s['messages']}\nпоставлено в AI: {s['queued']}\nотправлено: {s['sent']}\nошибок: {s['errors']}\nожидают: {pending}\nоткрытый чат: {s['last_current_dialog'] or 'нет'}\nпоследний пропуск: {s['last_skip'] or 'нет'}")

    def _show_help(self):
        self._dialog("Как пользоваться AutoResp", "AutoResp поддерживает Gemini, Groq и OpenRouter. Добавь один или несколько API key, выбери основной AI и оставь модель auto. При сбое, лимите или сетевой ошибке AutoResp может автоматически перейти к следующему провайдеру. Кнопка «Проверить все API» показывает статус каждого ключа отдельно. «Проверить работу плагина» проверяет сам плагин, API и тестовый AI-запрос. Если ты уже находишься в чате с человеком, AutoResp не отвечает — он отвечает, когда этот чат не открыт.")

    def _open_author_channel(self):
        try:
            fragment = get_last_fragment(); activity = fragment.getParentActivity() if fragment else None
            if activity: activity.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(AUTHOR_CHANNEL)))
        except Exception: pass

    def _dialog(self, title, message):
        def show():
            try:
                fragment = get_last_fragment(); activity = fragment.getParentActivity() if fragment else None
                if not activity: return
                builder = AlertDialogBuilder(activity); builder.set_title(title); builder.set_message(message); builder.set_positive_button("ок", lambda b, w: b.dismiss()); builder.show()
            except Exception: pass
        run_on_ui_thread(show)
